# ANASTASIA backend (Medusa v2) - šablona. Zkopírujte do .env a doplňte hodnoty.
# Nikdy nevkládejte skutečné klíče do tohoto souboru ani do gitu.
# Medusa Cloud: NODE_ENV, DATABASE_URL, REDIS_URL a S3_* nevyplňovat (spravuje Cloud), produkci určuje
# MEDUSA_CLOUD_ENVIRONMENT_TYPE. Seznam proměnných s flagy: docs/launch/DEPLOY-RUNBOOK-2026-10-23.md, příloha A.

NODE_ENV=development

# --- Databáze (Postgres je povinný) ---
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/medusa

# --- Redis (volitelné lokálně; v produkci doporučené/nutné). Bez hodnoty běží in-memory moduly. ---
# REDIS_URL=redis://localhost:6379

# --- Bezpečnost (produkce: min. 32 znaků, navzájem různé, ne "replace/local/change/supersecret") ---
JWT_SECRET=
COOKIE_SECRET=
# Dvojfaktorové overenie administrátora (TOTP): kľúč na šifrovanie MFA tajomstiev.
# Bez neho enrollácia odmietne (2FA sa nedá zapnúť). Vygeneruj napr. `openssl rand -hex 32`.
# Po nastavení ho nemeniť – inak sa nebudú dať overiť už zapísané faktory.
MFA_ENCRYPTION_KEY=

# --- CORS (produkce: jen https origin, bez koncového lomítka) ---
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:9000

# Veřejná URL backendu (pro lokální soubory)
BACKEND_PUBLIC_URL=http://localhost:9000

# --- Stripe (lokálně VŽDY sk_test_..., sk_live_ je mimo produkci odmítnut) ---
STRIPE_API_KEY=
# Lokálně z `stripe listen --forward-to localhost:9000/hooks/payment/stripe_stripe`
STRIPE_WEBHOOK_SECRET=
# true = platba se stáhne ihned (digitální produkty), false = ruční capture
STRIPE_CAPTURE=true
# Volitelné: ID Payment Method Configuration ze Stripe Dashboardu
STRIPE_PAYMENT_METHOD_CONFIGURATION=
# Jen smoke test na produkčním prostředí před spuštěním: 1 = testovací Stripe klíč místo live (live klíč je pak odmítnut).
# Mimo produkci nemá vliv. Po smoke testu smazat.
PAYMENTS_TEST_MODE=

# --- Soubory (volitelné; bez nich lokální disk). S3 / Cloudflare R2: ---
S3_FILE_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
S3_BUCKET=
# R2 / jiné S3-kompatibilní: https://<account>.r2.cloudflarestorage.com
S3_ENDPOINT=

# --- NEXUS pricing (server-to-server) ---
NEXUS_PRICING_URL=http://127.0.0.1:8787/api/nexus/pricing
# Volitelné; jinak se odvodí z NEXUS_PRICING_URL (/pricing -> /safeorder)
NEXUS_SAFEORDER_URL=
NEXUS_PRICING_API_KEY=
NEXUS_TENANT_ID=anastasia
# Události Medusy do NEXUS Workeru (https://<nexus>/api/webhooks/medusa); secret = Worker secret MEDUSA_WEBHOOK_SECRET
NEXUS_MEDUSA_WEBHOOK_URL=
NEXUS_MEDUSA_WEBHOOK_SECRET=
# Volitelné, prázdné = odvodí se: NEXUS_OPERATIONS_URL z NEXUS_PRICING_URL (/pricing -> /operations), OPS_INGEST_TENANT_ID = NEXUS_TENANT_ID
NEXUS_OPERATIONS_URL=
OPS_INGEST_TENANT_ID=

# --- NEXUS webhook forwarding (subscriber posílá eventy do NEXUS workeru) ---
NEXUS_WEBHOOK_URL=http://127.0.0.1:8787/api/webhooks/medusa
# Sdílený HMAC secret pro podpis webhooků (sdílí se s NEXUS MEDUSA_WEBHOOK_SECRET)
NEXUS_WEBHOOK_SECRET=

# --- Bootstrap (src/migration-scripts/anastasia-bootstrap.ts) ---
ANASTASIA_REGION_COUNTRIES=sk
ANASTASIA_WAREHOUSE_CITY=Bratislava
ANASTASIA_WAREHOUSE_COUNTRY=SK
ANASTASIA_WAREHOUSE_ADDRESS=
# Doprava zdarma od částky v EUR s DPH (prázdné = vypnuto); platí pro nově zakládaného kuriéra, pak se mění v adminu
ANASTASIA_FREE_SHIPPING_FROM_EUR=

# Chráněná média (A-07): tajemství min. 32 znaků (sdílí se s doručovacím Workerem), základ URL Workeru nad privátním R2
MEDIA_TOKEN_SECRET=
MEDIA_DELIVERY_BASE_URL=

# Passwordless přihlášení zákazníků (A-01, K6): základ URL stránky, kde se token z e-mailu potvrzuje
MAGIC_LINK_BASE_URL=

# --- Transakční e-maily přes Resend (hlavní provider podle smlouvy). ---
# Bez RESEND_API_KEY se e-maily jen zapíšou do logu (bez osobních údajů) -- žádný e-mail neodejde.
# Klíč = API key z účtu Resend; odesílatel musí být z domény ověřené v Resende.
RESEND_API_KEY=
# Adresa odesílatele z ověřené domény.
RESEND_FROM_EMAIL=
# Volitelné, výchozí ANASTASIA.
RESEND_FROM_NAME=ANASTASIA
# Volitelné, adresa, na kterou smerují odpovědi na e-maily.
RESEND_REPLY_TO=

# --- Záložný provider e-mailů (jen pro prostředí, která ještě neprošla na Resend). ---
# Použije se POUZE tehdy, když není nastavený RESEND_API_KEY. Nové nasazení má
# používat Resend; tento blok se po přepnutí smí smazat.
ZEPTOMAIL_API_KEY=
ZEPTOMAIL_FROM_EMAIL=
ZEPTOMAIL_FROM_NAME=ANASTASIA
ZEPTOMAIL_REPLY_TO=
# Volitelné, výchozí API URL poskytovatele.
ZEPTOMAIL_API_URL=
# Pojistka testovacího provozu: e-maily jen na tyto adresy / „@domény“ (čárkou). Při PAYMENTS_TEST_MODE=1, stagingu
# a náhledech PR platí vždy a bez seznamu neodejde nic. V ostrém provozu prázdné = bez omezení.
EMAIL_RECIPIENT_ALLOWLIST=
# Odkazy v e-mailech (bez nastavení e-mail odejde bez tlačítka). Objednávka = ACCOUNT_ORDERS_URL/<order_id>.
ACCOUNT_URL=
ACCOUNT_ORDERS_URL=
ACCOUNT_BOOKINGS_URL=
# Doručení darčekových poukazů e-mailem (jinak se jen zalogují): notification
GIFT_VOUCHER_DELIVERY=

# Provozní události (ops_event): retence ve dnech (události 7–730, výchozí 90; audit 365–3650, výchozí 1095)
OPS_EVENT_RETENTION_DAYS=
OPS_AUDIT_RETENTION_DAYS=
# Příjem warn/error událostí z NEXUS Workeru (POST /hooks/ops/edge-events): tajemství min. 32 znaků,
# stejná hodnota jako Worker secret OPS_INGEST_SECRET; Worker má OPS_INGEST_URL = <backend>/hooks/ops/edge-events
OPS_INGEST_SECRET=

# Právní texty (X1): verze schvaluje vlastník textů, max 100 znaků
LEGAL_TERMS_VERSION=
LEGAL_PRIVACY_VERSION=
NEWSLETTER_CONSENT_VERSION=
ORDER_SELF_CANCEL_BOOKING_HOURS=

# Chat (souhrn pro Lucii a odkazy v e-mailech); CHAT_ADMIN_URL = chat ve vlastním adminu (https://<admin>/#/chat)
CHAT_ADMIN_NOTIFY_EMAIL=
CHAT_ADMIN_URL=
CHAT_STOREFRONT_URL=

# Kontaktný formulár /kontakt (POST /store/contact) – kam chodia správy; prázdne = CHAT_ADMIN_NOTIFY_EMAIL, bez oboch 503
CONTACT_NOTIFY_EMAIL=
# retence obsahu chatu ve dnech (30–3650, výchozí 365)
CHAT_RETENTION_DAYS=
# QR odkazy kupónů z adminu: https://<storefront>
COUPON_LINK_STOREFRONT_ORIGIN=
# Synchronizace konzultací z NEXUS Workeru (POST /hooks/nexus/booking-order): stejná hodnota jako Worker secret MEDUSA_BOOKING_SYNC_SECRET
NEXUS_BOOKING_SYNC_SECRET=

# --- Produktové feedy (veřejné /feeds/heureka.xml a /feeds/google.xml) ---
# Adresa webu, na ktorú smerujú odkazy v feede (https, bez cesty). První platná hodnota vyhráva:
# ANASTASIA_SITE_URL, STOREFRONT_URL, STOREFRONT_ORIGIN, COUPON_LINK_STOREFRONT_ORIGIN.
STOREFRONT_URL=
# Sadzba DPH v procentech pro výpočet ceny bez DPH v feedu (výchozí 20 pro Slovensko)
FEED_VAT_RATE=20
# Náhradní fotka pro produkty bez obrázku (bez ní se produkt bez fotky do feedu nedostane)
FEED_FALLBACK_IMAGE=

# --- Dopravci (Nastavení → Pripojenia → Dopravca) ---
# Tajemství na šifrování API klíče dopravce (min. 16 znaků). Bez něj se klíč neuloží; jinak se použije JWT_SECRET.
CARRIER_SETTINGS_SECRET=
