{
  // Testovací předání ANASTASIA (19. 10. 2026): storefront jako statické assety Workeru na subdoméně L-Code.
  // Neindexuje se (build bez ANASTASIA_SITE_URL → robots noindex, robots.txt Disallow, X-Robots-Tag v _headers).
  // Nasazení jen přes ./deploy.sh (kontroly testovacího režimu). Doména Lucie se tu nepoužívá.
  "$schema": "../../nexus/node_modules/wrangler/config-schema.json",
  "name": "anastasia-test-web",
  "account_id": "3a147fa6382bb87477201b385bb945ea",
  "compatibility_date": "2026-10-18",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "anastasia-test.l-code-dynamics.com", "custom_domain": true }],
  // Worker len pre obrázky z administrácie (/backend-media/static/… → API_ORIGIN/static/…) a videá/hudbu s Range (/media/…).
  // Ostatné ide priamo zo statických assetov, aby platili hlavičky z _headers (CSP, noindex).
  "main": "../../storefront-prototype/edge/worker.mjs",
  "vars": { "API_ORIGIN": "https://anastasia-test-api.l-code-dynamics.com" },
  "assets": {
    "directory": "../../storefront-prototype/dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/backend-media/*", "/media/*", "/eshop/produkt/mineralny-ochranny-krem-pre-citlivu-pokozku*"]
  }
}
