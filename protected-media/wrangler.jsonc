{
  "$schema": "../nexus/node_modules/wrangler/config-schema.json",
  "name": "anastasia-protected-media",
  "main": "worker.ts",
  "compatibility_date": "2026-10-19",
  "r2_buckets": [{"binding": "MEDIA_BUCKET", "bucket_name": "anastasia-media"}, {"binding": "MEDIA_BUCKET_PROTECTED", "bucket_name": "anastasia-paid-content-test"}],
  "vars": {"ALLOWED_ORIGINS": "http://127.0.0.1:4173,http://localhost:4173,http://127.0.0.1:4174,http://localhost:4174"}
}
